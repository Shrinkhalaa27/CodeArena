# Copy to .env. Placeholders only - NEVER commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://codearena:codearena@localhost:5432/codearena
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis                 # redis | inline (dev only) | memory (tests)
JWT_SECRET=change-me-use-a-long-random-value   # openssl rand -hex 32  (required, 32+ chars in production)
WEB_ORIGIN=http://localhost:3000

# Judging. judge0 = real sandbox. fake = test double for dev/CI only (refused in production).
JUDGE_BACKEND=judge0
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# AI assistant - disabled unless a provider AND its key are set (server-side only)
LLM_PROVIDER=none                   # none | gemini | groq | openrouter
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_DAILY_QUOTA=20

# Development bootstrap (ignored in production)
SEED_DEMO_USERS=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Browser-visible (public) - never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000
